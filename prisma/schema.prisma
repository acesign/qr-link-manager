// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model QrReservation {
  id           String   @id @default(cuid())
  qrId         String   @unique
  qrPath       String   @unique
  qrPublicUrl  String   @unique
  status       String   @default("reserved")
  customerId   String?
  customerEmail String?
  sessionId    String?
  cartToken    String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model QrCode {
  id                String   @id @default(cuid())
  shop              String
  qrCode            String   @unique
  qrDisplayCode     String?
  qrPath            String   @unique
  publicUrl         String?

  status            QrStatus @default(RESERVED)

  reservationId     String?  @unique
  orderId           String?
  orderName         String?
  orderLineItemId   String?
  customerId        String?
  customerEmail     String?

  targetUrl         String?
  redirectGid       String?
  metaobjectId      String?
  metaobjectHandle  String?

  reservedAt        DateTime?
  activatedAt       DateTime?
  lastScannedAt     DateTime?
  scanCount         Int      @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  scans             QrScan[]

  @@index([shop, orderId])
  @@index([shop, customerId])
  @@index([shop, status])
  @@index([shop, orderLineItemId])
}

model ProcessedWebhook {
  id               String   @id @default(cuid())
  shop             String
  topic            String
  webhookId        String
  orderId          String?
  processedAt      DateTime @default(now())

  @@unique([shop, webhookId])
  @@index([shop, topic, orderId])
}

model QrScan {
  id          String   @id @default(cuid())
  qrCodeId    String
  scannedAt   DateTime @default(now())
  referer     String?
  userAgent   String?
  ipHash      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  qrCode      QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId, scannedAt])
}

enum QrStatus {
  RESERVED
  PENDING
  ACTIVE
  DISABLED
  EXPIRED
}
